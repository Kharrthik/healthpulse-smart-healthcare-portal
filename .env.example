# ===================================================================
# HealthPulse Environment Configuration Template
# Duplicate this file to '.env' and provide your actual local credentials.
# NEVER commit the '.env' file to version control.
# ===================================================================

# Java Runtime (Optional override if JAVA_HOME is not in system PATH)
# JAVA_HOME=C:\Program Files\Java\jdk-21

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://127.0.0.1:3306/health_portal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Groq Cloud AI Engine (LLM Pre-Consultation Symptom Intake)
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server Port Configuration
SERVER_PORT=8080
FRONTEND_PORT=5173
